new file mode 100644
index 0000000..32e084c
--- /dev/null
+++ b/tests/test_campplus_adapter.py
@@ -0,0 +1,65 @@
+"""No-download gradient regression test for the CAM++ adapter.
+
+Run from the repo root: python -m unittest tests.test_campplus_adapter
+This stubs the WeSpeaker model to check integration/autograd independently
+of a real pretrained CAM++ checkpoint.
+"""
+import importlib.util
+import sys
+import tempfile
+import types
+import unittest
+from unittest import mock
+from pathlib import Path
+
+import torch
+from torch import nn
+
+ROOT = Path(__file__).resolve().parents[1]
+ENCODER_PATH = ROOT / 'sgmse' / 'speaker_encoders.py'
+
+
+class TinyFakeCAMPPlus(nn.Module):
+    def __init__(self, feat_dim=80, embed_dim=512, pooling_func='TSTP'):
+        super().__init__()
+        self.projection = nn.Linear(feat_dim, embed_dim)
+
+    def forward(self, x):
+        return self.projection(x.mean(dim=1))
+
+
+class AdapterTest(unittest.TestCase):
+    def test_embedding_and_waveform_input_grad(self):
+        fake_camp_module = types.ModuleType('wespeaker.models.campplus')
+        fake_camp_module.CAMPPlus = TinyFakeCAMPPlus
+        with mock.patch.dict(sys.modules, {
+            'wespeaker': types.ModuleType('wespeaker'),
+            'wespeaker.models': types.ModuleType('wespeaker.models'),
+            'wespeaker.models.campplus': fake_camp_module,
+        }):
+            spec = importlib.util.spec_from_file_location('test_speaker_encoders', ENCODER_PATH)
+            mod = importlib.util.module_from_spec(spec)
+            spec.loader.exec_module(mod)
+            with tempfile.TemporaryDirectory() as path:
+                model = TinyFakeCAMPPlus()
+                torch.save(model.state_dict(), Path(path) / 'avg_model.pt')
+                enc = mod.WeSpeakerCAMPPlusEncoder(path)
+                enh = torch.randn(2, 8000, requires_grad=True)
+                clean = torch.randn(2, 8000)
+                z_enh = enc(enh)
+                with torch.no_grad():
+                    z_clean = enc(clean)
+                self.assertEqual(z_enh.shape, (2, 512))
+                sim = torch.nn.functional.cosine_similarity(z_enh, z_clean).mean()
+                sim.backward()
+                self.assertIsNotNone(enh.grad)
+                self.assertTrue(torch.isfinite(enh.grad).all())
+                self.assertGreater(float(enh.grad.abs().sum()), 0)
+                self.assertTrue(all(not p.requires_grad for p in enc.parameters()))
+                self.assertTrue(all(p.grad is None for p in enc.parameters()))
+                enc.train()
+                self.assertFalse(enc.training)
+
+
+if __name__ == '__main__':
+    unittest.main()
