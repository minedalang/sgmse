  "references": [
    {
      "id": "p226_027",
      "original_text": "They should have a major rethink about the event for next year.\n",
      "raw_text_hex": "546865792073686f756c6420686176652061206d616a6f722072657468696e6b2061626f757420746865206576656e7420666f72206e65787420796561722e0a",
      "raw_text_sha256": "4c89a690f064039006e014051fd9c1520256f1fc8a454a312412600e13d8cbb3",
      "archive_entry": "trainset_28spk_txt/p226_027.txt"
    },
    {
      "id": "p226_028",
      "original_text": "Suggestions of the action being a punishment were dismissed.\n",
      "raw_text_hex": "53756767657374696f6e73206f662074686520616374696f6e206265696e6720612070756e6973686d656e742077657265206469736d69737365642e0a",
